# ---------------------------------------------------------------------------
# MarketPulse configuration. Copy to .env (or run `npm run setup`).
# Keys are read only by the Node server; they are never sent to the browser.
# ---------------------------------------------------------------------------

# live (default) or demo. Demo = static, clearly-labelled fixtures, no API calls.
MARKETPULSE_MODE=live
PORT=8787

# --- Twelve Data: quotes (US + TSX) and price charts -----------------------
# https://twelvedata.com/pricing  ·  docs: https://twelvedata.com/docs
TWELVEDATA_API_KEY=
# Your plan's limits (free "Basic" plan defaults shown; 0 = unlimited).
TWELVEDATA_CREDITS_PER_MINUTE=8
TWELVEDATA_CREDITS_PER_DAY=800
# What your plan ACTUALLY provides per region: real-time | delayed | end-of-day
# Check https://twelvedata.com/exchanges (XNAS, XNYS, XTSE rows) for your plan.
TWELVEDATA_US_TIMING=delayed
TWELVEDATA_US_DELAY_MINUTES=15
TWELVEDATA_TSX_TIMING=end-of-day
TWELVEDATA_TSX_DELAY_MINUTES=0
# Request pre/post-market fields (Twelve Data documents this for Pro plans and above).
TWELVEDATA_PREPOST=false

# --- Finnhub: company news, earnings calendar, market capitalisation -------
# https://finnhub.io/register  ·  docs: https://finnhub.io/docs/api
FINNHUB_API_KEY=
# Free tier is documented at 60 calls/min; 50 leaves headroom.
FINNHUB_CALLS_PER_MINUTE=50
# Only used if QUOTE_PROVIDER=finnhub
FINNHUB_US_TIMING=delayed
FINNHUB_US_DELAY_MINUTES=15
FINNHUB_TSX_TIMING=end-of-day

# Which adapter serves quotes: twelvedata (default when its key is set) | finnhub
# QUOTE_PROVIDER=twelvedata

# --- Scheduling -----------------------------------------------------------
# Lower bound for quote refresh; the server raises it to stay inside the credit budget.
MIN_QUOTE_REFRESH_SECONDS=60
CLOSED_MARKET_REFRESH_SECONDS=900
NEWS_REFRESH_SECONDS=600
NEWS_LOOKBACK_DAYS=7
EARNINGS_LOOKAHEAD_DAYS=120
