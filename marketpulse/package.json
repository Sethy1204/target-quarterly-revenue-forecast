{
  "name": "marketpulse",
  "version": "1.0.0",
  "private": true,
  "description": "MarketPulse \u2014 stock quotes, charts, company news and in-app alerts for a fixed watchlist.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "start:demo": "tsx server/index.ts --demo",
    "test": "vitest run",
    "test:e2e": "tsx e2e/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
